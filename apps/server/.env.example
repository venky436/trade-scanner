PORT=4002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_scanner
REDIS_URL=redis://localhost:6379

# Kite API
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Market mode: "commodity" (MCX) or "equity" (NSE top 100)
MARKET_MODE=commodity

# Frontend URL (for auth redirect after Kite login)
FRONTEND_URL=http://localhost:3000

# ─── AI Verdict Module (Experimental) ──────────────────────────────────────
# Plug-in / plug-out via a single flag. When AI_MODE_ENABLED is unset or
# anything other than "true", zero AI code paths execute (no scheduler, no
# routes, no Gemini calls, no API key needed). See docs/AI_VERDICT_MODULE_PLAN.md
AI_MODE_ENABLED=false
GEMINI_API_KEY=

# ─── Order execution (Trade screen) ─────────────────────────────────────────
# Paper / Real is chosen with the switch in the navbar (saved in data/trade-mode.json).
# There is no .env flag for it. First start = Paper.
# Starting capital for PAPER mode (₹)
PAPER_CAPITAL=25000
# Intraday timing (IST). No new entries from ENTRY_CUTOFF; everything still open
# is closed at SQUARE_OFF_AT. Keep SQUARE_OFF_AT a few minutes before Zerodha's
# own MIS auto square-off (it charges a fee for that).
ENTRY_CUTOFF=14:45
SQUARE_OFF_AT=15:00
