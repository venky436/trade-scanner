PORT=4002
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trading_scanner
REDIS_URL=redis://localhost:6379

# Kite API
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Market mode: "commodity" (MCX) or "equity" (NSE top 100)
MARKET_MODE=commodity

# Frontend URL (for auth redirect after Kite login)
FRONTEND_URL=http://localhost:3000

# ─── AI Verdict Module (Experimental) ──────────────────────────────────────
# Plug-in / plug-out via a single flag. When AI_MODE_ENABLED is unset or
# anything other than "true", zero AI code paths execute (no scheduler, no
# routes, no Gemini calls, no API key needed). See docs/AI_VERDICT_MODULE_PLAN.md
AI_MODE_ENABLED=false
GEMINI_API_KEY=
